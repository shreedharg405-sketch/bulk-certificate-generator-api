# CertiFlow Server Configuration
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
NODE_ENV=development

# Storage Configuration
STORAGE_DIR=storage
CHUNK_SIZE=50
MAX_CONCURRENT_RENDERS=5

# SQLite Database
DB_PATH=storage/database.sqlite

# Queue Driver ('auto' | 'bullmq' | 'local')
# 'auto' will connect to BullMQ if Redis is running, otherwise safely fallback to Local Async Queue
QUEUE_DRIVER=auto
QUEUE_NAME=certificate-generation-queue

# Redis (for BullMQ in production or Docker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: Custom Chrome / Chromium executable path
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
